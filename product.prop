# Audio
af.fast_track_multiplier=1
audio.deep_buffer.media=true
audio.offload.min.duration.secs=30
audio.offload.video=true
audio.timecheck.timeout_duration_ms=8000
ro.af.client_heap_size_kbyte=7168

# Bluetooth
bluetooth.device_id.vendor_id=0x001D

# GMS
ro.opa.device_model_id=ga-oplus-skill-os121-211011

# LMKD
ro.config.low_ram=true
ro.lmk.low=1001
ro.lmk.medium=800
ro.lmk.critical=0
ro.lmk.critical_upgrade=false
ro.lmk.upgrade_pressure=90
ro.lmk.downgrade_pressure=80
ro.lmk.kill_heaviest_task=true
ro.lmk.kill_timeout_ms=100
ro.lmk.use_minfree_levels=true
ro.lmk.psi_partial_stall_ms=70
ro.lmk.thrashing_limit=70
ro.lmk.swap_util_max=70
ro.lmk.swap_free_low_percentage=30
